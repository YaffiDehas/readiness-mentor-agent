# Copy to .env and fill in. NEVER commit the real .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM-as-judge model for evals (fixed for all comparisons)
JUDGE_MODEL=openai/gpt-4o-mini

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=safeai-readiness-mentor

# Optional
# Cap on tokens per LLM answer (OpenRouter reserves credit for the cap; 402 if balance < cap)
MAX_OUTPUT_TOKENS=3000
MENTOR_NAME=מנטורית
